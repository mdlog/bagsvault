# =============================================================================
# BagsVault backend — environment template
# Copy to .env and fill in real values. NEVER commit .env.
# =============================================================================

# ---- Core ----
MONGO_URL=mongodb://localhost:27017
DB_NAME=bagsvault
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# ---- Solana ----
# Cluster: devnet | testnet | mainnet-beta (or full RPC URL)
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet
# Commitment level: processed | confirmed | finalized
SOLANA_COMMITMENT=confirmed

# Keypair file paths (Solana JSON format — list of 64 ints)
# Generated by scripts/gen_keypair.py — store in backend/keys/, never commit.
SOLANA_RELAYER_KEYPAIR=keys/relayer.json
SOLANA_TREASURY_KEYPAIR=keys/treasury.json
SOLANA_TOKEN_AUTHORITY_KEYPAIR=keys/token_authority.json

# ---- BagsVault on-chain (set after Anchor program deploy) ----
# Default placeholder matches `programs/bagsvault/src/lib.rs::declare_id!`.
# Override after `anchor deploy` writes a real program id.
BAGSVAULT_PROGRAM_ID=BAGSVau1tProgram11111111111111111111111111111
# Sunspot Groth16 verifier program (only set if you delegate verification
# via CPI instead of the in-program `groth16-solana` path).
BAGSVAULT_VERIFIER_ID=
VAULT_TOKEN_MINT=

# ---- Bags API ----
# Get key at https://dev.bags.fm/login. Endpoints requiring it return 503 if blank.
BAGS_API_BASE_URL=https://api.bags.fm
BAGS_API_KEY=

# ---- Range Risk API ----
# Get key at https://www.range.org/. Endpoints requiring it return 503 if blank.
RANGE_API_BASE_URL=https://api.range.org
RANGE_API_KEY=

# ---- Rate limiting ----
RATE_LIMIT_PER_MINUTE=120

# ---- Auth (wallet signature) ----
# Max age (seconds) for signed messages — replays older than this rejected.
AUTH_MESSAGE_MAX_AGE_SECONDS=300

# ---- Relayer ----
# Default fee charged by this node when acting as relayer (basis points).
RELAYER_FEE_BPS=15
# Region tag advertised in /api/relayers (informational).
RELAYER_REGION=US-East
# Display name for this relayer node.
RELAYER_NAME=BagsVault-Default
# Compute-unit budget cap when building withdrawal txs.
RELAYER_MAX_COMPUTE_UNITS=400000

# ---- Phase 3: indexer + tx lifecycle ----
# How often the background Merkle indexer polls the program account.
INDEXER_INTERVAL_SECONDS=15
# Set false to start the API without the background indexer (useful in tests).
INDEXER_ENABLED=true
# Path to the BagsVault Anchor IDL (JSON). Defaults to the in-tree IDL
# committed under repo-root `idl/bagsvault.json` so the backend boots out
# of the box once the program is deployed.
BAGSVAULT_IDL_PATH=../idl/bagsvault.json
# Optional WebSocket RPC URL for log subscriptions. If empty, derived from
# SOLANA_RPC_URL by swapping http(s)://→ws(s)://.
SOLANA_WS_URL=

# Always simulate transactions before broadcast (catches errors early).
TX_SIMULATION_REQUIRED=true
# Compute-unit price (micro-lamports) added as a priority fee.
TX_PRIORITY_FEE_MICROLAMPORTS=1000
# Retry settings for transient RPC errors (blockhash expired, rate limit, etc).
TX_RETRY_MAX_ATTEMPTS=3
TX_RETRY_INITIAL_BACKOFF_MS=500
# Max time (seconds) to wait for a tx to reach the configured commitment level.
TX_CONFIRM_TIMEOUT_SECONDS=60

# ---- Phase 4: ZK proof generator ----
# Directory containing the Noir circuit (`circuits/bagsvault_withdraw`).
# Default points at the in-tree circuit committed at repo root.
ZK_CIRCUIT_DIR=../circuits/bagsvault_withdraw
# Tooling binaries — must be present on PATH for real proofs. The service
# falls back to a stub-proof mode (rejected on-chain) when missing.
ZK_NARGO_BIN=nargo
ZK_BB_BIN=bb
# Set true to emit zero-byte stub proofs instead of invoking nargo/bb.
# Useful for local plumbing tests; **never** enable in production.
ZK_PROOF_STUB_MODE=false
