# =============================================================================
# BagsVault backend — environment template
# Copy to .env and fill in real values. NEVER commit .env.
# =============================================================================

# ---- Core ----
MONGO_URL=mongodb://localhost:27017
DB_NAME=bagsvault
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# ---- Solana ----
# Cluster: devnet | testnet | mainnet-beta (or full RPC URL)
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet
# Commitment level: processed | confirmed | finalized
SOLANA_COMMITMENT=confirmed

# Keypair file paths (Solana JSON format — list of 64 ints)
# Generated by scripts/gen_keypair.py — store in backend/keys/, never commit.
SOLANA_RELAYER_KEYPAIR=keys/relayer.json
SOLANA_TREASURY_KEYPAIR=keys/treasury.json
SOLANA_TOKEN_AUTHORITY_KEYPAIR=keys/token_authority.json

# ---- BagsVault on-chain (set after Anchor program deploy) ----
# Until set, endpoints depending on on-chain state return 503.
BAGSVAULT_PROGRAM_ID=
BAGSVAULT_VERIFIER_ID=
VAULT_TOKEN_MINT=

# ---- Bags API ----
# Get key at https://dev.bags.fm/login. Endpoints requiring it return 503 if blank.
BAGS_API_BASE_URL=https://api.bags.fm
BAGS_API_KEY=

# ---- Range Risk API ----
# Get key at https://www.range.org/. Endpoints requiring it return 503 if blank.
RANGE_API_BASE_URL=https://api.range.org
RANGE_API_KEY=

# ---- Rate limiting ----
RATE_LIMIT_PER_MINUTE=120

# ---- Auth (wallet signature) ----
# Max age (seconds) for signed messages — replays older than this rejected.
AUTH_MESSAGE_MAX_AGE_SECONDS=300

# ---- Relayer ----
# Default fee charged by this node when acting as relayer (basis points).
RELAYER_FEE_BPS=15
# Region tag advertised in /api/relayers (informational).
RELAYER_REGION=US-East
# Display name for this relayer node.
RELAYER_NAME=BagsVault-Default
# Compute-unit budget cap when building withdrawal txs.
RELAYER_MAX_COMPUTE_UNITS=400000
